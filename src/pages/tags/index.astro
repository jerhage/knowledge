---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import TagList from '../../components/TagList.astro';

const docs = await getCollection('docs');
const counts = new Map<string, number>();
for (const doc of docs) {
	for (const tag of doc.data.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.keys()].sort();
---

<StarlightPage frontmatter={{ title: 'Tags', description: `${tags.length} tags across the knowledge base.`, pagefind: false }}>
	<TagList tags={tags} counts={counts} />
</StarlightPage>
