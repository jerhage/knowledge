---
import { tagHref } from '../tags';

interface Props {
	tags: readonly string[];
	counts?: Map<string, number>;
}

const { tags, counts } = Astro.props;
---

<ul class="sl-tags" aria-label="Tags">
	{
		tags.map((tag) => (
			<li>
				<a href={tagHref(tag)}>
					{tag}
					{counts && <span class="count">{counts.get(tag)}</span>}
				</a>
			</li>
		))
	}
</ul>

<style>
	.sl-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.125rem 0.625rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	a:hover {
		border-color: var(--sl-color-text-accent);
		background: var(--sl-color-accent-low);
	}
	.count {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}
</style>
